":""},{"id":"M44","name":"拉盖尔多项式","latex":"xL_n''+(1-x)L_n'+nL_n=0","group":"math","module":"数学前备库","link":"math.md","deriv":"","app":false,"note":""},{"id":"M45","name":"正交多项式统一性质","latex":"\\text{Rodrigues 公式、递推、完备性}","group":"math","module":"数学前备库","link":"math.md","deriv":"","app":false,"note":""},{"id":"M46","name":"概率密度与归一化","latex":"\\rho(x)\\ge0,\\ \\int\\rho(x)dx=1","group":"math","module":"数学前备库","link":"math.md","deriv":"","app":false,"note":""},{"id":"M47","name":"期望/方差/标准差","latex":"\\langle x\\rangle=\\int x\\rho\\,dx,\\ \\sigma^2=\\langle x^2\\rangle-\\langle x\\rangle^2","group":"math","module":"数学前备库","link":"math.md","deriv":"","app":false,"note":""},{"id":"M48","name":"高斯分布","latex":"\\rho(x)=\\frac1{\\sqrt{2\\pi\\sigma^2}}e^{-(x-\\mu)^2/2\\sigma^2}","group":"math","module":"数学前备库","link":"math.md","deriv":"","app":false,"note":""},{"id":"M49","name":"泊松分布","latex":"P(n)=\\frac{\\lambda^n}{n!}e^{-\\lambda},\\ \\langle n\\rangle=\\lambda,\\ \\sigma=\\sqrt\\lambda","group":"math","module":"数学前备库","link":"math.md","deriv":"","app":false,"note":""},{"id":"M50","name":"协方差与相关性","latex":"\\operatorname{Cov}(x,y)=\\langle xy\\rangle-\\langle x\\rangle\\langle y\\rangle","group":"math","module":"数学前备库","link":"math.md","deriv":"","app":false,"note":""},{"id":"M51","name":"中心极限定理","latex":"\\text{大量独立变量之和}\\to\\text{高斯分布}","group":"math","module":"数学前备库","link":"math.md","deriv":"","app":false,"note":""},{"id":"M52","name":"欧拉法/龙格–库塔","latex":"y_{n+1}=y_n+hf(x_n,y_n)\\ (\\text{欧拉})","group":"math","module":"数学前备库","link":"math.md","deriv":"","app":false,"note":""},{"id":"M53","name":"有限差分","latex":"\\psi''(x_j)\\approx\\frac{\\psi_{j+1}-2\\psi_j+\\psi_{j-1}}{\\Delta^2}","group":"math","module":"数学前备库","link":"math.md","deriv":"","app":false,"note":""},{"id":"M54","name":"矩阵本征值数值解","latex":"\\text{幂法/QR/Lanczos}","group":"math","module":"数学前备库","link":"math.md","deriv":"","app":false,"note":""},{"id":"M55","name":"打靶法","latex":"\\text{扫参数 }E\\text{ 使边界条件满足；